meta {
  name: GenerateTestRecap
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/recaps/generations
  body: json
  auth: none
}

body:json {
  {
    "type": "Test",
    "publish": true
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("generationRequestedAt", new Date().toISOString());
}

docs {
  Génère et publie un récap de test (ADR-007) : fausse source, sans LLM, aucun crédit consommé.
  Publie sur test.json, jamais sur latest.json ni demo.json.
  Exige un serveur dont le GithubToken est renseigné.
}
