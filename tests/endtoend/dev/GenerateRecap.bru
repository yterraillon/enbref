meta {
  name: GenerateRecap
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/recaps/generations
  body: json
  auth: none
}

body:json {
  {
    "type": "Test",
    "publish": false
  }
}

assert {
  res.status: eq 200
  res.body.headlineCount: gt 0
}

docs {
  Déclenche une génération d'un récap de test, qui n'est jamais publié.
  Il lit une fausse source : aucun appel aux flux réels.
}
