# =============================================================================
# Stack enbref-local — copier en .env.local et renseigner
# =============================================================================

# Token GitHub — publication sur yterraillon.github.io
# ⚠️ Laisser vide en local : renseigné, une génération écrase le récap de PRODUCTION.
GithubToken=

# Clé de l'API Claude — génération du récap. En Production, le modèle est claude-opus-5-5.
Anthropic__ApiKey=

# Alertes ntfy — échecs de la génération quotidienne et de la vérification de publication.
# Vides : aucune alerte ne part (elles restent dans les logs). Un topic de test pour essayer.
# Sans Ntfy__Url, les alertes partent sur https://ntfy.sh. Ne pas la laisser vide.
# Ntfy__Url=https://ntfy.checquy.ovh
Ntfy__Topic=
Ntfy__Token=
