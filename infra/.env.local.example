# =============================================================================
# Stack enbref-local — copier en .env.local et renseigner
# =============================================================================

# Clé API OpenAI — génération et formatage du récap
OpenAiApiKey=<openai-api-key>

# Token GitHub — publication de latest-recap.json sur yterraillon.github.io
# ⚠️ Laisser vide en local : renseigné, une génération écrase le récap de PRODUCTION.
GithubToken=

# Token ntfy — notification en cas d'échec de génération (ntfy.checquy.ovh)
NtfyToken=<ntfy-token>

# Connection string Azure Blob — hérité de myfanwy, inutilisé depuis le passage
# au CDN GitHub (les readers/writers Azure sont commentés dans la DI).
EnBrefConnectionString=
