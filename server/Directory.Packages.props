<Project>
  <!-- Toute entrée nouvelle est une décision : elle s'accompagne d'un ADR. -->
  <ItemGroup>
    <!-- ADR-005 -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
    <PackageVersion Include="System.ServiceModel.Syndication" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="TUnit" Version="1.78.0" />
    <!-- ADR-003 -->
    <PackageVersion Include="Anthropic" Version="12.60.0" />
  </ItemGroup>
</Project>
