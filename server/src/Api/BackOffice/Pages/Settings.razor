@page "/back-office/settings"
@using EnBref.Infrastructure.Alerting
@using EnBref.Infrastructure.Llm
@using Microsoft.Extensions.Options
@inject DailyGenerationSettingsStore DailyGeneration
@inject ILlmClient LlmClient
@inject IOptions<AnthropicOptions> AnthropicOptions
@inject IHostEnvironment Environment
@inject IAlertSender AlertSender
@inject IOptions<NtfyOptions> NtfyOptions
@inject TimeProvider TimeProvider
@implements IDisposable

<PageTitle>EnBref — Réglages</PageTitle>

<div class="bo-page bo-page--form">
    <LargeTitle Title="Réglages" />

    <div>
        <ListSection Header="Génération" Footer="Le récap du jour est vérifié une heure après l’heure de génération. Si la génération du jour a déjà eu lieu, une heure plus tardive la relance aujourd’hui.">
            <ListRow>
                <Title>Génération quotidienne</Title>
                <Trailing>
                    <Switch Checked="DailyGeneration.Current.IsStarted" CheckedChanged="ToggleDailyGeneration" Label="Génération quotidienne" />
                </Trailing>
            </ListRow>
            <div class="bo-form">
                <TextField Id="generation-time" Type="time" Label="Heure de génération"
                           Value="@DailyGeneration.Current.Time.ToString("HH:mm")" ValueChanged="SetTime" />
            </div>
            <ListRow Compact="true">
                <Title>Prochaine génération</Title>
                <Trailing><span class="body eb-muted">@DailyGenerationTexts.NextGeneration(DailyGeneration.Current, TimeProvider.GetUtcNow(), TimeProvider.LocalTimeZone)</span></Trailing>
            </ListRow>
        </ListSection>

        <ListSection Header="Alertes" Footer="Les échecs de la génération quotidienne et de la vérification de publication sont envoyés sur ntfy.">
            <ListRow Compact="true">
                <Title>Topic ntfy</Title>
                <Trailing><span class="body eb-muted">@DailyGenerationTexts.Topic(NtfyOptions.Value.Topic)</span></Trailing>
            </ListRow>
            <div class="bo-form">
                <div class="bo-actions">
                    <Button Disabled="isSendingAlert" OnClick="SendTestAlertAsync">@(isSendingAlert ? "Envoi…" : "Envoyer une alerte de test")</Button>
                    @if (alertResult is not null)
                    {
                        <DisplayBadge Value="Badges.ForAlert(alertResult)" />
                    }
                </div>
                @if (alertResult?.Error is { } alertError)
                {
                    <div class="footnote bo-error">@alertError</div>
                }
            </div>
        </ListSection>

        <ListSection Header="Modèle" Footer="Le modèle rédige les brèves à partir des titres collectés.">
            <ListRow Value="@AnthropicOptions.Value.Model">
                <Title>Modèle</Title>
            </ListRow>
        </ListSection>

        <ListSection Header="Tester le modèle" Footer="Envoie un message au modèle configuré, sans rien publier.">
            <div class="bo-form">
                <TextField Id="llm-message" Label="Message" Placeholder="Résume en une phrase : Blocus des lycées, 141 établissements fermés" @bind-Value="message" />
                <div class="bo-actions">
                    @* Pas d'appel au chargement : seul le clic consomme des crédits. *@
                    <Button Disabled="isSending || string.IsNullOrWhiteSpace(message)" OnClick="SendAsync">@(isSending ? "Envoi…" : "Envoyer")</Button>
                    @if (response is not null)
                    {
                        <DisplayBadge Value="Badges.ForLlm(response.Status)" />
                    }
                </div>
                <div class="bo-response" role="status">
                    <div class="eyebrow">Réponse</div>
                    @if (response is null)
                    {
                        <div class="subhead eb-muted">La réponse du modèle s’affiche ici.</div>
                    }
                    else
                    {
                        <div class="subhead">@response.Content</div>
                        @if (response.Error is not null)
                        {
                            <div class="footnote bo-error">@response.Error</div>
                        }
                    }
                </div>
            </div>
        </ListSection>

        <ListSection Header="Système">
            <ListRow Compact="true">
                <Title>Version</Title>
                <Trailing><span class="body eb-num eb-muted">@ServerVersion.Current</span></Trailing>
            </ListRow>
            <ListRow Compact="true">
                <Title>Environnement</Title>
                <Trailing><span class="body eb-muted">@Environment.EnvironmentName</span></Trailing>
            </ListRow>
            <ListRow Compact="true">
                <Title>Démarré le</Title>
                <Trailing><span class="body eb-num eb-muted">@FrenchDates.Moment(ServerVersion.StartedAt)</span></Trailing>
            </ListRow>
        </ListSection>
    </div>
</div>

@code {
    private const string Prompt = "Réponds en une phrase.";

    private string? message;
    private LlmResponse? response;
    private bool isSending;
    private AlertResult? alertResult;
    private bool isSendingAlert;

    // Un autre onglet peut changer les réglages : la page suit.
    protected override void OnInitialized() => DailyGeneration.Changed += OnSettingsChanged;

    public void Dispose() => DailyGeneration.Changed -= OnSettingsChanged;

    private void OnSettingsChanged(DailyGenerationSettings _) => InvokeAsync(StateHasChanged);

    private void SetTime(string? value)
    {
        // Saisie incomplète : le champ renvoie une chaîne vide, l'heure reste inchangée.
        if (TimeOnly.TryParse(value, out var time))
        {
            DailyGeneration.SetTime(time);
        }
    }

    private async Task SendTestAlertAsync()
    {
        isSendingAlert = true;
        alertResult = null;
        alertResult = await AlertSender.SendAsync(
            new Alert("Alerte de test", "Les alertes d’EnBref arrivent bien sur ce topic."), CancellationToken.None);
        isSendingAlert = false;
    }

    private async Task SendAsync()
    {
        isSending = true;
        response = null;
        response = await LlmClient.SendAsync(new LlmRequest(Prompt, message!), CancellationToken.None);
        isSending = false;
    }

    private void ToggleDailyGeneration(bool isStarted)
    {
        if (isStarted)
        {
            DailyGeneration.Start();
        }
        else
        {
            DailyGeneration.Stop();
        }
    }
}
