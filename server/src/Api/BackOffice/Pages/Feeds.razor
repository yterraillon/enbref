@page "/back-office/feeds"
@using EnBref.Api.Features.CollectHeadlines
@using EnBref.Infrastructure.Collection
@inject CollectHeadlinesHandler CollectHeadlines

<PageTitle>EnBref — Flux RSS</PageTitle>

<div class="bo-page">
    <LargeTitle Eyebrow="@(collection is null ? "Collecte…" : RecapCounts.Count(collection.Headlines.Count, "titre collecté", "titres collectés"))" Title="Flux RSS">
        <Trailing>
            <Button Disabled="isCollecting" OnClick="CollectAsync">@(isCollecting ? "Collecte…" : "Recharger les flux")</Button>
        </Trailing>
    </LargeTitle>

    @if (collection is not null)
    {
        <div class="bo-feeds">
            @foreach (var feed in collection.Feeds)
            {
                var isExpanded = expanded.Contains(feed.Feed.Url);
                <Card Class="bo-card--flush" Label="@feed.Feed.Source">
                    <div class="bo-feed-head">
                        <div class="bo-feed-title">
                            <h2 class="article-title-l">@feed.Feed.Source</h2>
                            <DisplayBadge Value="Badges.ForFeed(feed.Status)" />
                        </div>
                        <a href="@feed.Feed.Url" target="_blank" rel="noopener" class="footnote bo-feed-url">@feed.Feed.Url</a>
                        @if (feed.Error is not null)
                        {
                            <div class="footnote bo-error">@feed.Error</div>
                        }
                        <div class="eyebrow eb-num bo-feed-count">@RecapCounts.Count(feed.Headlines.Count, "titre", "titres")</div>
                    </div>
                    @if (feed.Headlines.Count > 0)
                    {
                        <ol class="bo-headlines">
                            @foreach (var headline in isExpanded ? feed.Headlines : feed.Headlines.Take(CollapsedCount))
                            {
                                <li class="subhead">@headline</li>
                            }
                        </ol>
                    }
                    @if (feed.Headlines.Count > CollapsedCount)
                    {
                        <div class="bo-feed-foot">
                            <Button Variant="ButtonVariant.Plain" aria-expanded="@(isExpanded ? "true" : "false")" OnClick="() => Toggle(feed.Feed.Url)">
                                @(isExpanded ? "Réduire" : $"Afficher les {feed.Headlines.Count} titres")
                            </Button>
                        </div>
                    }
                </Card>
            }
        </div>
    }
</div>

@code {
    private const int CollapsedCount = 6;

    [Inject(Key = FeedReaderKeys.Rss)]
    private IFeedReader RssFeedReader { get; set; } = null!;

    private readonly HashSet<Uri> expanded = [];
    private CollectionResult? collection;
    private bool isCollecting;

    protected override Task OnInitializedAsync() => CollectAsync();

    private async Task CollectAsync()
    {
        isCollecting = true;
        collection = await CollectHeadlines.HandleAsync(RssFeedReader, CancellationToken.None);
        isCollecting = false;
    }

    private void Toggle(Uri url)
    {
        if (!expanded.Remove(url))
        {
            expanded.Add(url);
        }
    }
}
