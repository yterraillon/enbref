@page "/back-office/info"
@inject IHostEnvironment Environment

<PageTitle>EnBref — Info</PageTitle>

<h1>Info</h1>

<dl>
    <dt>Version</dt>
    <dd>@ServerVersion.Current</dd>
    <dt>Environnement</dt>
    <dd>@Environment.EnvironmentName</dd>
    <dt>Démarré le</dt>
    <dd>@ServerVersion.StartedAt.ToString("dd/MM/yyyy HH:mm:ss zzz")</dd>
</dl>
