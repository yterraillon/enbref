<button type="button" role="switch" class="eb-switch" aria-checked="@(Checked ? "true" : "false")" aria-label="@Label"
        disabled="@Disabled" @onclick="ToggleAsync"></button>

@code {
    [Parameter]
    public bool Checked { get; set; }

    [Parameter]
    public EventCallback<bool> CheckedChanged { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private Task ToggleAsync() => CheckedChanged.InvokeAsync(!Checked);
}
