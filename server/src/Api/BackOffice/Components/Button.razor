<button type="button" class="@CssClass" disabled="@Disabled" @onclick="OnClick" @attributes="AdditionalAttributes">
    @if (Icon is { } icon)
    {
        <Icon Name="icon" />
    }
    @if (ChildContent is not null)
    {
        <span>@ChildContent</span>
    }
</button>

@code {
    [Parameter]
    public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;

    [Parameter]
    public IconName? Icon { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => Variant == ButtonVariant.Plain
        ? "eb-btn eb-btn--plain subhead"
        : "eb-btn eb-btn--primary headline";
}
