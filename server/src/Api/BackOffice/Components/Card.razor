@* Bloc surface + radius-card, pour ce qui n'est pas une liste. *@
<section class="@CssClass" aria-label="@Label" @attributes="AdditionalAttributes">@ChildContent</section>

@code {
    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => Class is null ? "bo-card" : $"bo-card {Class}";
}
