@* Tracés repris du composant Icon de design-system/components/bundle.js, en currentColor. *@
@switch (Name)
{
    case IconName.Play:
        <svg width="12" height="14" viewBox="0 0 11 13" aria-hidden="true" focusable="false" style="display: block"><path d="M1 1l9 5.5L1 12z" fill="currentColor" /></svg>
        break;
    case IconName.Pause:
        <svg width="12" height="14" viewBox="0 0 11 13" aria-hidden="true" focusable="false" style="display: block"><rect x="1" y="1" width="3" height="11" fill="currentColor" /><rect x="7" y="1" width="3" height="11" fill="currentColor" /></svg>
        break;
    case IconName.SkipForward:
        <svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true" focusable="false" style="display: block"><path d="M1 1l7 6-7 6zM9 1l7 6-7 6z" fill="currentColor" /></svg>
        break;
    case IconName.Check:
        <svg width="11" height="9" viewBox="0 0 11 9" aria-hidden="true" focusable="false" style="display: block"><path d="M1 4.5l3 3L10 1" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
        break;
    case IconName.ChevronRight:
        <svg width="7" height="12" viewBox="0 0 7 12" aria-hidden="true" focusable="false" style="display: block"><path d="M1 1l5 5-5 5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" /></svg>
        break;
    case IconName.ChevronUp:
        <svg width="13" height="8" viewBox="0 0 12 8" aria-hidden="true" focusable="false" style="display: block"><path d="M1 7l5-5 5 5" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" /></svg>
        break;
    case IconName.ChevronDown:
        <svg width="13" height="8" viewBox="0 0 12 8" aria-hidden="true" focusable="false" style="display: block"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" /></svg>
        break;
}

@code {
    [Parameter, EditorRequired]
    public IconName Name { get; set; }
}
